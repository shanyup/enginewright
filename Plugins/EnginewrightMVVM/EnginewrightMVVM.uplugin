{
  "FileVersion": 3,
  "Version": 5,
  "VersionName": "0.4.0",
  "FriendlyName": "Enginewright MVVM",
  "Description": "Adds MVVM support (viewmodel_list, viewmodel_add, viewmodel_bind, viewmodel_unbind, viewmodel_remove) to Enginewright. Needs Epic's UMG Viewmodel plugin. Leave it off in projects that do not use MVVM: Enginewright works without it.",
  "Category": "Editor",
  "CreatedBy": "Shanyup Studios",
  "CreatedByURL": "https://github.com/shanyup/enginewright",
  "DocsURL": "https://github.com/shanyup/enginewright#readme",
  "CanContainContent": false,
  "IsBetaVersion": true,
  "EnabledByDefault": false,
  "Modules": [
    {
      "Name": "EnginewrightMVVM",
      "Type": "Editor",
      "LoadingPhase": "PostEngineInit",
      "PlatformAllowList": [ "Win64", "Mac", "Linux" ]
    }
  ],
  "Plugins": [
    { "Name": "Enginewright", "Enabled": true },
    { "Name": "ModelViewViewModel", "Enabled": true }
  ]
}
