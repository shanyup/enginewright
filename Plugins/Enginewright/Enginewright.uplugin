{
  "FileVersion": 3,
  "Version": 5,
  "VersionName": "0.4.0",
  "FriendlyName": "Enginewright",
  "Description": "Native MCP server inside the Unreal Editor. No Python, Node or proxy. Strict, verified edits.",
  "Category": "Editor",
  "CreatedBy": "Shanyup Studios",
  "CreatedByURL": "https://github.com/shanyup/enginewright",
  "DocsURL": "https://github.com/shanyup/enginewright#readme",
  "CanContainContent": false,
  "IsBetaVersion": true,
  "EnabledByDefault": true,
  "Modules": [
    {
      "Name": "Enginewright",
      "Type": "Editor",
      "LoadingPhase": "PostEngineInit",
      "PlatformAllowList": [ "Win64", "Mac", "Linux" ]
    }
  ],
  "Plugins": [
    { "Name": "EnhancedInput", "Enabled": true },
    { "Name": "DataValidation", "Enabled": true },
    { "Name": "GameplayTagsEditor", "Enabled": true }
  ]
}
